'use client';

import Link from 'next/link';
import { useCallback, useEffect, useState } from 'react';
import { motion, useReducedMotion, type Variants } from 'framer-motion';
import { ArrowLeft, ArrowRight, Pause, Play } from 'lucide-react';
import Image from 'next/image';
import { CONTACT, MICROS } from '@/lib/bim';
import { PHOTOS, SIMULATOR } from '@/lib/content';

const EASE = [0.22, 1, 0.36, 1] as const;
const AUTOPLAY_MS = 7000;

const AI_MICROS = ['21', '18', '19', '20'].map((code) => MICROS.find((m) => m.code === code)!);

interface Slide {
  id: string;
  tab: string;
  bg: string;
  pre?: string;
  mark: string;
  post?: string;
  text: string;
  cta: { href: string; label: string };
  badge?: string;
  visual: React.ReactNode;
}

/** Tarjeta blanca común a los fragmentos de interfaz del carrusel: la elevación se declara una sola vez, con sombra. */
function Panel({ children, className = '' }: { children: React.ReactNode; className?: string }) {
  return (
    <div className={`bg-[#fff] text-[#0d1522] rounded-2xl p-7 shadow-[0_40px_70px_-34px_rgba(0,10,40,0.7)] ${className}`}>{children}</div>
  );
}

function PhotoVisual() {
  const p = PHOTOS.clase;
  return (
    <div className="max-w-lg ml-auto overflow-hidden rounded-2xl shadow-[0_40px_70px_-34px_rgba(0,10,40,0.7)]">
      <Image src={p.src} width={p.width} height={p.height} alt={p.alt} priority sizes="(min-width: 1024px) 40vw, 0px" className="w-full h-auto" />
    </div>
  );
}

function StepsVisual() {
  return (
    <Panel className="max-w-md ml-auto">
      <div className="flex items-center justify-between gap-3">
        <p className="text-sm font-semibold text-[#0d1522]/70">Un proyecto completo, con empresas como cliente</p>
        <span className="text-[11px] font-bold rounded-full bg-[#ffba08] text-[#0a1f44] px-2.5 py-1">Novedad</span>
      </div>
      <ol className="mt-4 divide-y divide-[#0a1f44]/10">
        {SIMULATOR.steps.map((step, i) => (
          <li key={step} className="flex items-center gap-4 py-2.5">
            <span className="font-kinetic font-bold text-sm text-[#0052cc] w-6">{String(i + 1).padStart(2, '0')}</span>
            <span className="font-semibold text-[15px]">{step}</span>
          </li>
        ))}
      </ol>
    </Panel>
  );
}

function AiVisual() {
  return (
    <Panel className="max-w-md ml-auto">
      <div className="flex items-center justify-between gap-3">
        <p className="text-sm font-semibold text-[#0d1522]/70">Herramientas que aprenderás</p>
        <span className="text-[11px] font-bold rounded-full bg-[#ffba08] text-[#0a1f44] px-2.5 py-1">Nuevo</span>
      </div>
      <ul className="mt-4 divide-y divide-[#0a1f44]/10">
        {AI_MICROS.map((m) => (
          <li key={m.code} className="flex items-center justify-between gap-4 py-3.5">
            <span className="font-semibold text-[15px]">{m.title}</span>
            <span className="text-sm text-[#0d1522]/70 shrink-0">{m.ects} ECTS</span>
          </li>
        ))}
      </ul>
      <p className="mt-4 pt-4 border-t border-[#0a1f44]/12 text-sm font-semibold">La IA propone, tú decides.</p>
    </Panel>
  );
}

function CertVisual() {
  return (
    <div className="max-w-md ml-auto flex flex-col items-stretch">
      <Panel>
        <p className="text-sm font-semibold text-[#0d1522]/70">Formación + experiencia</p>
        <p className="font-kinetic font-bold text-2xl text-[#0052cc] mt-2">Competencias y práctica profesional</p>
        <p className="text-[13px] text-[#0d1522]/70 mt-1">Microcredenciales, másteres y simulador profesional</p>
      </Panel>
      <div className="relative h-14 mx-auto w-0.5 bg-[#fff]/25 overflow-hidden" aria-hidden="true">
        <span className="hc-flow absolute inset-x-0 h-6 bg-[#fff]" />
      </div>
      <Panel>
        <p className="font-kinetic font-bold text-2xl text-[#0d1522]">Certificado profesional</p>
        <p className="text-[15px] font-semibold mt-1">Tu carnet digital de competencias</p>
        <p className="text-[13px] text-[#0d1522]/70 mt-1">Emitido por AECOMI y verificable por cualquier empresa</p>
      </Panel>
    </div>
  );
}

const SLIDES: Slide[] = [
  {
    id: 'competencias',
    tab: 'Formamos en competencias',
    bg: '#0a1f44',
    mark: 'Formamos en competencias',
    text: 'La escuela tecnológica para arquitectos e ingenieros. Certificación universitaria UTAMED · Certificación profesional AECOMI.',
    cta: { href: '/formacion', label: 'Programas' },
    badge: 'Business & Tech School · Learning by Working',
    visual: <PhotoVisual />,
  },
  {
    id: 'simulador',
    tab: 'Simulador profesional',
    bg: '#0042a3',
    pre: 'Te damos la',
    mark: 'experiencia profesional',
    post: 'que necesitas',
    badge: 'Novedad · Simulador profesional',
    text: 'Un proyecto completo con empresas reales como cliente, antes de tu primer contrato.',
    cta: { href: '/simulador', label: 'Leer más' },
    visual: <StepsVisual />,
  },
  {
    id: 'certificacion',
    tab: 'Certifica tu perfil',
    bg: '#00132e',
    pre: 'Certifica tu',
    mark: 'perfil profesional',
    text: 'Las empresas ya no buscan currículum. Buscan que sepas hacer el trabajo.',
    cta: { href: '/certificacion', label: 'Leer más' },
    visual: <CertVisual />,
  },
  {
    id: 'ia',
    tab: 'IA aplicada',
    bg: '#0052cc',
    pre: 'No te contamos la IA.',
    mark: 'La aplicamos',
    badge: 'Novedad · IA aplicada a la arquitectura y la ingeniería',
    text: 'Del estudio previo a la operación del edificio, la inteligencia artificial ya forma parte de nuestros programas.',
    cta: { href: '/ia-bim', label: 'Programas de IA' },
    visual: <AiVisual />,
  },
];

export default function HeroCarousel() {
  const reduce = useReducedMotion();
  const [index, setIndex] = useState(0);
  const [ready, setReady] = useState(false);
  const [manualPause, setManualPause] = useState(false);
  const [hover, setHover] = useState(false);
  const [touchX, setTouchX] = useState<number | null>(null);

  useEffect(() => setReady(true), []);

  const go = useCallback((i: number) => setIndex(((i % SLIDES.length) + SLIDES.length) % SLIDES.length), []);
  const running = !reduce && !manualPause && !hover;

  const container: Variants = {
    hide: { transition: { duration: 0 } },
    show: { transition: { staggerChildren: reduce ? 0 : 0.09, delayChildren: reduce ? 0 : 0.12 } },
  };
  const rise: Variants = {
    hide: { opacity: 0, y: reduce ? 0 : 26, transition: { duration: 0.2 } },
    show: { opacity: 1, y: 0, transition: { duration: reduce ? 0 : 0.75, ease: EASE } },
  };
  const slideIn: Variants = {
    hide: { opacity: 0, x: reduce ? 0 : 48, transition: { duration: 0.2 } },
    show: { opacity: 1, x: 0, transition: { duration: reduce ? 0 : 0.9, ease: EASE, delay: reduce ? 0 : 0.3 } },
  };

  return (
    <section
      role="region"
      aria-roledescription="carrusel"
      aria-label="Programas destacados"
      onMouseEnter={() => setHover(true)}
      onMouseLeave={() => setHover(false)}
      onFocusCapture={() => setHover(true)}
      onBlurCapture={() => setHover(false)}
      onKeyDown={(e) => {
        if (e.key === 'ArrowRight') go(index + 1);
        if (e.key === 'ArrowLeft') go(index - 1);
      }}
      onTouchStart={(e) => setTouchX(e.touches[0].clientX)}
      onTouchEnd={(e) => {
        if (touchX === null) return;
        const dx = e.changedTouches[0].clientX - touchX;
        if (Math.abs(dx) > 50) go(index + (dx < 0 ? 1 : -1));
        setTouchX(null);
      }}
      className="relative isolate overflow-hidden text-[#fff] min-h-[640px] h-[100svh] max-h-[880px] grid"
    >
      <h1 className="sr-only">
        {CONTACT.name} {CONTACT.tagline}: másteres BIM, microcredenciales y certificación de perfiles
      </h1>

      {SLIDES.map((slide, i) => {
        const active = i === index;
        return (
          <div
            key={slide.id}
            role="group"
            aria-roledescription="diapositiva"
            aria-label={`${i + 1} de ${SLIDES.length}`}
            aria-hidden={!active}
            inert={!active}
            className="[grid-area:1/1] relative transition-[opacity,visibility] duration-700 ease-out"
            style={{ background: slide.bg, opacity: active ? 1 : 0, visibility: active ? 'visible' : 'hidden', zIndex: active ? 1 : 0 }}
          >
            <div className="hc-grid" aria-hidden="true" />
            <motion.div
              variants={container}
              initial="hide"
              animate={active && ready ? 'show' : 'hide'}
              className="relative mx-auto max-w-[1320px] h-full px-[clamp(20px,5vw,72px)] pt-36 md:pt-48 pb-32 grid lg:grid-cols-[1.05fr_0.95fr] gap-10 lg:gap-16 items-center"
            >
              <div>
                <motion.h2
                  variants={rise}
                  className="font-kinetic font-bold text-[clamp(2rem,4.4vw,3.6rem)] leading-[1.18] tracking-[-0.02em] text-balance"
                >
                  {slide.pre && <span>{slide.pre} </span>}
                  <span className="inline bg-[#fff] text-[#0a1f44] px-3 box-decoration-clone">{slide.mark}</span>
                  {slide.post && <span> {slide.post}</span>}
                </motion.h2>
                {slide.badge && (
                  <motion.p variants={rise} className="mt-5">
                    <span className="inline-block text-xs font-bold rounded-full bg-[#ffba08] text-[#0a1f44] px-3 py-1">{slide.badge}</span>
                  </motion.p>
                )}
                <motion.p variants={rise} className="mt-6 text-lg md:text-xl leading-relaxed text-[#fff]/85 max-w-[34rem]">
                  {slide.text}
                </motion.p>
                <motion.div variants={rise} className="mt-9">
                  <Link
                    href={slide.cta.href}
                    className="group inline-flex items-center gap-3 rounded-full bg-[#ffba08] text-[#0a1f44] pl-7 pr-3 py-2.5 min-h-12 font-semibold hover:bg-[#fff] transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#fff]"
                  >
                    {slide.cta.label}
                    <span className="w-9 h-9 rounded-full bg-[#0a1f44] text-[#fff] flex items-center justify-center transition-transform group-hover:translate-x-1">
                      <ArrowRight className="w-4 h-4" aria-hidden="true" />
                    </span>
                  </Link>
                </motion.div>
              </div>
              <motion.div variants={slideIn} className="hidden lg:block">
                {slide.visual}
              </motion.div>
            </motion.div>
          </div>
        );
      })}

      {/* Controles: pestañas con progreso, anterior/siguiente y pausa */}
      <div className="absolute inset-x-0 bottom-0 z-10">
        <div className="mx-auto max-w-[1320px] px-[clamp(20px,5vw,72px)] pb-7 flex items-end justify-between gap-6">
          <div className="flex items-end gap-2 sm:gap-4 flex-1 min-w-0">
            {SLIDES.map((slide, i) => {
              const active = i === index;
              return (
                <button
                  key={slide.id}
                  type="button"
                  onClick={() => go(i)}
                  aria-label={`Ir a la diapositiva ${i + 1}: ${slide.tab}`}
                  aria-current={active}
                  className="group relative flex-1 max-w-48 text-left pt-5 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#fff] rounded-sm"
                >
                  <span className={`hidden lg:block text-[13px] font-semibold mb-2.5 transition-colors ${active ? 'text-[#fff]' : 'text-[#fff]/65 group-hover:text-[#fff]'}`}>
                    {slide.tab}
                  </span>
                  <span className="block h-[3px] rounded-full bg-[#fff]/25 overflow-hidden">
                    {active && (
                      <span
                        key={index}
                        className={`block h-full bg-[#fff] origin-left ${reduce ? '' : 'hc-progress'}`}
                        style={{
                          transform: reduce ? 'scaleX(1)' : undefined,
                          animationDuration: `${AUTOPLAY_MS}ms`,
                          animationPlayState: running ? 'running' : 'paused',
                        }}
                        onAnimationEnd={() => go(index + 1)}
                      />
                    )}
                  </span>
                </button>
              );
            })}
          </div>
          <div className="flex items-center gap-2 shrink-0">
            <button
              type="button"
              onClick={() => setManualPause((v) => !v)}
              aria-label={manualPause ? 'Reanudar el carrusel' : 'Pausar el carrusel'}
              className="hidden sm:inline-flex w-11 h-11 items-center justify-center rounded-full border border-[#fff]/35 hover:bg-[#fff] hover:text-[#0a1f44] transition-colors cursor-pointer"
            >
              {manualPause ? <Play className="w-4 h-4" aria-hidden="true" /> : <Pause className="w-4 h-4" aria-hidden="true" />}
            </button>
            <button
              type="button"
              onClick={() => go(index - 1)}
              aria-label="Diapositiva anterior"
              className="w-11 h-11 inline-flex items-center justify-center rounded-full border border-[#fff]/35 hover:bg-[#fff] hover:text-[#0a1f44] transition-colors cursor-pointer"
            >
              <ArrowLeft className="w-5 h-5" aria-hidden="true" />
            </button>
            <button
              type="button"
              onClick={() => go(index + 1)}
              aria-label="Diapositiva siguiente"
              className="w-11 h-11 inline-flex items-center justify-center rounded-full border border-[#fff]/35 hover:bg-[#fff] hover:text-[#0a1f44] transition-colors cursor-pointer"
            >
              <ArrowRight className="w-5 h-5" aria-hidden="true" />
            </button>
          </div>
        </div>
      </div>
    </section>
  );
}
